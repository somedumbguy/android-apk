#!/usr/bin/env bash
# Full coding-standards check before every push: formatting, duplication, compiler
# warnings, Android Lint, unit and architecture tests, and test coverage.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Secret scan, when gitleaks is installed locally (CI always runs it).
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --redact --no-banner .; then
        echo
        echo "gitleaks found a secret, so nothing was pushed. Remove it, and rotate the key if it was real."
        exit 1
    fi
fi

if ! ./gradlew --quiet check; then
    echo
    echo "./gradlew check failed, so nothing was pushed. Fix the problems above and push again."
    exit 1
fi
